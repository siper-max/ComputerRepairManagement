@using ComputerRepairManagement.Models.Database
@model IEnumerable<KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
    var customers = Model?.ToList() ?? new List<KhachHang>();
}


<style>
    .customer-page {
        padding: 20px 0;
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .version-label {
        background-color: #e9ecef;
        color: #555;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
    }

    .customer-form {
        background-color: #ffffff;
        border: 1px solid #e0e3e8;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 28px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    .customer-list {
        background-color: #ffffff;
        color: #212529;
        border: 1px solid #e0e3e8;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    .customer-list-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .customer-count {
        color: #6c757d;
        font-size: 14px;
    }

    .customer-table {
        width: 100%;
        border-collapse: collapse;
        color: #212529;
    }

        .customer-table th {
            padding: 14px 12px;
            text-align: left;
            background-color: #f5f6f8;
            border-bottom: 1px solid #dee2e6;
            white-space: nowrap;
        }

        .customer-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
        }

        .customer-table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .customer-table tr[hidden] {
            display: none !important;
        }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .action-buttons form {
            margin: 0;
        }

    .customer-page .btn {
        border-radius: 7px;
    }

    .edit-box {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 20px;
        border-radius: 10px;
    }

    .empty-message {
        text-align: center;
        color: #6c757d;
        padding: 30px !important;
    }
</style>


<div class="customer-page">

    <div class="page-heading">
        <h2 class="mb-0">Quản lý khách hàng</h2>
    </div>

    <!-- THÊM KHÁCH HÀNG -->

    <div class="customer-form">

        <h4 class="mb-3">Thêm khách hàng mới</h4>

        <form asp-controller="KhachHangs"
              asp-action="Save"
              method="post">

            <input type="hidden" name="id" value="0" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Họ và tên
                    </label>

                    <input type="text"
                           name="hoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên"
                           maxlength="100"
                           required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Số điện thoại
                    </label>

                    <input type="tel"
                           name="soDienThoai"
                           class="form-control"
                           placeholder="Nhập số điện thoại"
                           maxlength="20"
                           required />
                </div>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                + Thêm khách hàng
            </button>

        </form>

    </div>

    <!-- DANH SÁCH KHÁCH HÀNG -->

    <div class="customer-list">

        <div class="customer-list-heading">

            <h4 class="mb-0">
                Danh sách khách hàng
            </h4>

            <span class="customer-count">
                Tổng số: @customers.Count khách hàng
            </span>

        </div>

        <div class="table-responsive">

            <table class="customer-table">

                <thead>
                    <tr>
                        <th style="width: 10%;">ID</th>
                        <th style="width: 35%;">Họ và tên</th>
                        <th style="width: 30%;">Số điện thoại</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (customers.Count == 0)
                    {
                        <tr>
                            <td colspan="4"
                                class="empty-message">
                                Chưa có khách hàng.
                            </td>
                        </tr>
                    }

                    @foreach (var item in customers)
                    {
                        <tr>
                            <td>@item.Id</td>

                            <td>@item.HoTen</td>

                            <td>@item.SoDienThoai</td>

                            <td>
                                <div class="action-buttons">

                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            aria-expanded="false"
                                            onclick="toggleEdit(@item.Id, this)">
                                        Sửa
                                    </button>

                                    <form asp-controller="KhachHangs"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này không?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Xóa
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        <!-- FORM CHỈNH SỬA -->

                        <tr id="edit-@item.Id" hidden>

                            <td colspan="4">

                                <div class="edit-box">

                                    <h5>Chỉnh sửa khách hàng</h5>

                                    <form asp-controller="KhachHangs"
                                          asp-action="Save"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <div class="row">

                                            <div class="col-md-6 mb-3">

                                                <label class="form-label">
                                                    Họ và tên
                                                </label>

                                                <input type="text"
                                                       name="hoTen"
                                                       value="@item.HoTen"
                                                       class="form-control"
                                                       maxlength="100"
                                                       required />

                                            </div>

                                            <div class="col-md-6 mb-3">

                                                <label class="form-label">
                                                    Số điện thoại
                                                </label>

                                                <input type="tel"
                                                       name="soDienThoai"
                                                       value="@item.SoDienThoai"
                                                       class="form-control"
                                                       maxlength="20"
                                                       required />

                                            </div>

                                        </div>

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Lưu chỉnh sửa
                                        </button>

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                onclick="closeEdit(@item.Id)">
                                            Hủy
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>
    function toggleEdit(id, button) {
        const row = document.getElementById("edit-" + id);
        row.hidden = !row.hidden;
        button.setAttribute("aria-expanded", String(!row.hidden));
    }

    function closeEdit(id) {
        const row = document.getElementById("edit-" + id);
        row.hidden = true;

        const button = row.previousElementSibling
            .querySelector(".btn-warning");

        button.setAttribute("aria-expanded", "false");
    }
</script>
