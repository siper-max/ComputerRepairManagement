@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            HỆ THỐNG QUẢN LÝ SỬA CHỮA MÁY TÍNH
        </h1>

        <p class="lead text-muted">
            Quản lý tiếp nhận, kiểm tra và sửa chữa
            máy tính một cách nhanh chóng.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Quản lý khách hàng</h4>
                    <p>Lưu trữ thông tin khách hàng.</p>
                    <a href="#" class="btn btn-primary">
                        Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Tiếp nhận máy tính</h4>
                    <p>Ghi nhận thiết bị cần sửa chữa.</p>
                    <a href="#" class="btn btn-success">
                        Tiếp nhận
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h4>Quản lý sửa chữa</h4>
                    <p>Theo dõi tiến độ sửa chữa.</p>
                    <a href="#" class="btn btn-warning">
                        Xem phiếu sửa chữa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
